<local:AdaptiveDesktopWindow x:Class="DesktopManager.App.CalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopManager.App"
        Title="日历窗口" Width="420" Height="390" MinWidth="350" MinHeight="330"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" Background="Transparent" AllowsTransparency="True"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource GlassTextBrush}">
    <Window.Resources>
    </Window.Resources>
    <Border CornerRadius="12" Background="{StaticResource GlassDarkBrush}" BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
            <Border x:Name="TitleBar" Background="Transparent" BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="0,0,0,1" Cursor="SizeAll" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Style="{StaticResource GlassWidgetIconButton}" Content="&#xE76B;" ToolTip="上个月" AutomationProperties.Name="上个月" Click="Previous_Click"/>
                    <TextBlock x:Name="MonthText" Grid.Column="1" VerticalAlignment="Center" Margin="8,0" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold"/>
                    <Button Grid.Column="2" Style="{StaticResource GlassWidgetIconButton}" Content="&#xE76C;" ToolTip="下个月" AutomationProperties.Name="下个月" Click="Next_Click"/>
                    <Button Grid.Column="3" Style="{StaticResource GlassWidgetActionButton}" Margin="5,0,0,0" Click="Today_Click" Content="今天"/>
                    <Button Grid.Column="4" Style="{StaticResource GlassWidgetIconButton}" Margin="4,0,0,0" Content="&#xE711;" ToolTip="关闭日历窗口" AutomationProperties.Name="关闭日历窗口" Click="CloseWindow_Click"/>
                </Grid>
            </Border>
            <UniformGrid Grid.Row="1" Columns="7" Margin="12,5,12,0">
                <TextBlock Text="一"/><TextBlock Text="二"/><TextBlock Text="三"/><TextBlock Text="四"/><TextBlock Text="五"/><TextBlock Text="六"/><TextBlock Text="日"/>
            </UniformGrid>
            <ItemsControl x:Name="DaysItems" Grid.Row="2" Margin="10,2,10,6">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate><Border Margin="2" Padding="4" CornerRadius="7" BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}" Background="{Binding Background}">
                    <Grid><TextBlock VerticalAlignment="Top" Text="{Binding Day}" Foreground="{Binding Foreground}" FontFamily="{StaticResource DataFont}"/><StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock HorizontalAlignment="Right" FontSize="9" Foreground="{Binding MarkerBrush}" Text="{Binding Marker}"/><TextBlock HorizontalAlignment="Right" MaxWidth="42" FontSize="8" Foreground="{Binding MarkerBrush}" TextTrimming="CharacterEllipsis" Text="{Binding HolidayName}"/></StackPanel></Grid>
                </Border></DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="DataStatusText" Grid.Row="3" Margin="14,0" Foreground="{StaticResource GlassMutedBrush}" FontSize="10" Text="法定节假日与调休数据"/>
        </Grid>
    </Border>
</local:AdaptiveDesktopWindow>
