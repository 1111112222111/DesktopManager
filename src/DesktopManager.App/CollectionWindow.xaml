<Window x:Class="DesktopManager.App.CollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="收纳窗口" Width="400" Height="300" MinWidth="280" MinHeight="46"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True" AllowDrop="True"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource GlassTextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Drop="Window_Drop" DragOver="Window_DragOver" PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="GlassIconButton" TargetType="Button">
            <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" /><Setter Property="Foreground" Value="#BFD1C9C5" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="15" /><Setter Property="FocusVisualStyle" Value="{StaticResource QuietFocusVisual}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" CornerRadius="9" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#18FFFFFF" /><Setter Property="Foreground" Value="White" /></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#26FFFFFF" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GlassItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource GlassTextBrush}" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="2" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource QuietFocusVisual}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#12FFFFFF" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1FFFFFFF" /><Setter Property="BorderBrush" Value="{StaticResource ChampagneBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GlassScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Background" Value="#55FFFFFF" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb">
                <Border x:Name="ThumbBody" Width="4" Margin="2,0" CornerRadius="2" Background="{TemplateBinding Background}" />
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="#88FFFFFF" /></Trigger>
                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbBody" Property="Background" Value="{StaticResource ChampagneBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Width="8" Background="Transparent">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Background="Transparent" BorderThickness="0" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb Style="{StaticResource GlassScrollThumb}" /></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Background="Transparent" BorderThickness="0" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
        </Style>
        <ContextMenu x:Key="QuickSortContextMenu">
            <MenuItem Header="粘贴" InputGestureText="Ctrl+V" Click="PasteItem_Click" />
            <Separator />
            <MenuItem Header="按首字母（A–Z）" Click="SortByName_Click" />
            <MenuItem Header="按文件大小（从大到小）" Click="SortBySize_Click" />
            <MenuItem Header="按类别" Click="SortByKind_Click" />
            <MenuItem Header="按修改日期（最新优先）" Click="SortByModifiedAt_Click" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Border x:Name="WindowBorder" CornerRadius="12" Background="{StaticResource GlassDarkBrush}"
                BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="1" SnapsToDevicePixels="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="46" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border x:Name="TitleBar" Background="Transparent" BorderBrush="#20FFFFFF" BorderThickness="0,0,0,1" Cursor="SizeAll" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="16,0,8,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ZoneNameText" VerticalAlignment="Center" Foreground="{StaticResource GlassTextBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ViewModeButton" Style="{StaticResource GlassIconButton}" Margin="0,0,2,0" AutomationProperties.Name="切换为列表视图" Click="ViewMode_Click" ToolTip="切换为列表视图">
                                <Grid Width="17" Height="17">
                                    <Path x:Name="ListModeIcon" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M1,2 H4 V5 H1 Z M6,2 H16 V4 H6 Z M1,7 H4 V10 H1 Z M6,7 H16 V9 H6 Z M1,12 H4 V15 H1 Z M6,12 H16 V14 H6 Z" />
                                    <Path x:Name="GridModeIcon" Visibility="Collapsed" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M1,1 H7 V7 H1 Z M10,1 H16 V7 H10 Z M1,10 H7 V16 H1 Z M10,10 H16 V16 H10 Z" />
                                </Grid>
                            </Button>
                            <Button Style="{StaticResource GlassIconButton}" Margin="0,0,2,0" AutomationProperties.Name="打开收纳目录" Click="OpenFolder_Click" ToolTip="打开目录" Content="&#xE8B7;" />
                            <Button Style="{StaticResource GlassIconButton}" Margin="0,0,2,0" AutomationProperties.Name="设置此收纳窗口" Click="WindowSettings_Click" ToolTip="窗口设置" Content="&#xE713;" />
                            <Button x:Name="CollapseButton" Style="{StaticResource GlassIconButton}" AutomationProperties.Name="折叠收纳窗口" Click="Collapse_Click" ToolTip="折叠">
                                <Grid Width="16" Height="16">
                                    <Path x:Name="CollapseIcon" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,10 L8,5 L13,10" />
                                    <Path x:Name="ExpandIcon" Visibility="Collapsed" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M3,6 L8,11 L13,6" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid x:Name="ContentPanel" Grid.Row="1" Margin="12,8,12,10" Background="Transparent"
                      PreviewMouseLeftButtonDown="ContentPanel_MouseLeftButtonDown"
                      PreviewMouseMove="ContentPanel_PreviewMouseMove"
                      PreviewMouseLeftButtonUp="ContentPanel_PreviewMouseLeftButtonUp"
                      LostMouseCapture="ContentPanel_LostMouseCapture"
                      PreviewMouseRightButtonDown="ContentPanel_MouseRightButtonDown">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border x:Name="NavigationBar" Visibility="Collapsed" Margin="2,0,2,6" Padding="2,0" Background="#0AFFFFFF" CornerRadius="8">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="NavigateUpButton" Style="{StaticResource GlassIconButton}" Width="30" Height="30" MinHeight="30"
                                    DockPanel.Dock="Left" Content="&#xE72B;" Click="NavigateUp_Click" ToolTip="返回上一级"
                                    AutomationProperties.Name="返回上一级" />
                            <TextBlock x:Name="CurrentPathText" Margin="4,0,8,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource GlassMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>
                    <StackPanel x:Name="EmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="40" Height="40" Margin="0,0,0,10" CornerRadius="20" BorderBrush="#88AA8959" BorderThickness="1">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ChampagneBrush}" FontFamily="Segoe Fluent Icons" FontSize="15" Text="&#xE710;" />
                        </Border>
                        <TextBlock Foreground="{StaticResource GlassMutedBrush}" TextAlignment="Center" Text="拖入文件，保留原始图标与格式" />
                    </StackPanel>
                    <ListBox x:Name="GridItemsList" Grid.Row="1" SelectionMode="Extended" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource GlassItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Items_MouseDoubleClick"
                             PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="Items_PreviewMouseRightButtonDown"
                             PreviewMouseMove="Items_PreviewMouseMove" ContextMenuOpening="Items_ContextMenuOpening" KeyDown="Items_KeyDown">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel Width="88" Margin="6,8" ToolTip="{Binding Path}">
                                <Image Width="36" Height="36" HorizontalAlignment="Center" Stretch="Uniform" Source="{Binding Icon}" />
                                <TextBlock Margin="4,7,4,0" Foreground="{StaticResource GlassTextBrush}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                <TextBlock Margin="2,3,2,0" Foreground="{StaticResource GlassMutedBrush}" FontFamily="{StaticResource DataFont}" FontSize="8" TextAlignment="Center" Text="{Binding SizeText}" />
                            </StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                        <ListBox.ContextMenu><ContextMenu>
                            <MenuItem Header="打开" Click="OpenItem_Click" /><MenuItem Header="在资源管理器中定位" Click="LocateItem_Click" /><Separator />
                            <MenuItem Header="复制" InputGestureText="Ctrl+C" Click="CopyItem_Click" /><MenuItem Header="粘贴" InputGestureText="Ctrl+V" Click="PasteItem_Click" /><Separator />
                            <MenuItem Header="上移" InputGestureText="Ctrl+↑" Click="MoveItemUp_Click" /><MenuItem Header="下移" InputGestureText="Ctrl+↓" Click="MoveItemDown_Click" /><Separator />
                            <MenuItem Header="重命名" Click="RenameItem_Click" /><MenuItem Header="移动到其他目录" Click="MoveOutItem_Click" /><MenuItem Header="删除（移入回收站）" Click="DeleteItem_Click" />
                        </ContextMenu></ListBox.ContextMenu>
                    </ListBox>
                    <ListView x:Name="ListItemsList" Grid.Row="1" SelectionMode="Extended" Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                              Foreground="{StaticResource GlassTextBrush}" ItemContainerStyle="{StaticResource GlassItem}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                              MouseDoubleClick="Items_MouseDoubleClick" PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown"
                              PreviewMouseRightButtonDown="Items_PreviewMouseRightButtonDown" PreviewMouseMove="Items_PreviewMouseMove"
                              ContextMenuOpening="Items_ContextMenuOpening" KeyDown="Items_KeyDown">
                        <ListView.ItemTemplate><DataTemplate>
                            <Grid Margin="7,5">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Image Width="26" Height="26" HorizontalAlignment="Left" Stretch="Uniform" Source="{Binding Icon}" />
                                <TextBlock Grid.Column="1" Margin="6,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource GlassTextBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource GlassMutedBrush}" FontFamily="{StaticResource DataFont}" FontSize="9" Text="{Binding SizeText}" />
                            </Grid>
                        </DataTemplate></ListView.ItemTemplate>
                        <ListView.ContextMenu><ContextMenu>
                            <MenuItem Header="打开" Click="OpenItem_Click" /><MenuItem Header="在资源管理器中定位" Click="LocateItem_Click" /><Separator />
                            <MenuItem Header="复制" InputGestureText="Ctrl+C" Click="CopyItem_Click" /><MenuItem Header="粘贴" InputGestureText="Ctrl+V" Click="PasteItem_Click" /><Separator />
                            <MenuItem Header="上移" InputGestureText="Ctrl+↑" Click="MoveItemUp_Click" /><MenuItem Header="下移" InputGestureText="Ctrl+↓" Click="MoveItemDown_Click" /><Separator />
                            <MenuItem Header="重命名" Click="RenameItem_Click" /><MenuItem Header="移动到其他目录" Click="MoveOutItem_Click" /><MenuItem Header="删除（移入回收站）" Click="DeleteItem_Click" />
                        </ContextMenu></ListView.ContextMenu>
                    </ListView>
                    <Canvas Grid.RowSpan="2" Panel.ZIndex="20" IsHitTestVisible="False">
                        <Border x:Name="SelectionMarquee" Visibility="Collapsed"
                                Background="{StaticResource GlassSelectionFillBrush}"
                                BorderBrush="{StaticResource ChampagneBrush}" BorderThickness="1" CornerRadius="4" />
                    </Canvas>
                </Grid>
                <TextBlock x:Name="StatusText" Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
