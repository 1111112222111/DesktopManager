<Window x:Class="DesktopManager.App.FavoriteRebindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重新绑定收藏夹成员" Width="780" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PorcelainBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="23" FontWeight="Bold" Foreground="#18201D" Text="选择新的桌面项目" />
        <TextBlock x:Name="OldPathText" Grid.Row="1" Margin="0,7,0,14" Foreground="{StaticResource GraphiteBrush}"
                   TextWrapping="Wrap" />
        <ListView x:Name="CandidatesList" Grid.Row="2" SelectionChanged="CandidatesList_SelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="范围" Width="90" DisplayMemberBinding="{Binding Scope}" />
                    <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding Kind}" />
                    <GridViewColumn Header="项目" Width="180" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="路径" Width="360" DisplayMemberBinding="{Binding Path}" />
                </GridView>
            </ListView.View>
        </ListView>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource GraphiteBrush}"
                       Text="只替换当前收藏夹中的关系，不移动或重命名文件。" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Padding="14,8" Click="Cancel_Click" Content="取消" />
                <Button x:Name="ConfirmButton" Margin="8,0,0,0" Padding="14,8"
                        IsEnabled="False" Click="Confirm_Click" Style="{StaticResource QuietPrimaryButton}"
                        Content="确认重新绑定" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
