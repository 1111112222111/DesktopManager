<Window x:Class="DesktopManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌面管理" Width="1280" Height="820"
        MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PorcelainBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource QuietPrimaryButton}" />
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Padding" Value="13,8" />
        </Style>
        <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource QuietCard}" />
        <Style x:Key="TableMenuButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style x:Key="MetricCell" TargetType="Border">
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFF9F1E7" BorderBrush="#55AA8959" BorderThickness="0,0,0,1">
            <TextBlock x:Name="ModeBannerText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource ChampagneDeepBrush}" FontSize="11"
                       Text="技术验证模式 · 仅操作系统临时目录 · 不会访问真实桌面" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="214" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F8FAF7" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="20,28,20,24">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" BorderBrush="{StaticResource InkBrush}" BorderThickness="1">
                            <Border Width="5" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource ChampagneBrush}" />
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold" Text="桌面管理" />
                            <TextBlock Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource DataFont}" FontSize="9" Text="DESKTOP FILING" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,38,0,0">
                        <Button x:Name="InboxNavButton" Style="{StaticResource NavButton}" Background="White" Click="ShowInbox_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Width="24" FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE119;" /><TextBlock Text="收件箱" /></StackPanel>
                        </Button>
                        <Button x:Name="FavoritesNavButton" Style="{StaticResource NavButton}" Visibility="Collapsed" Click="ShowFavorites_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Width="24" FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE734;" /><TextBlock Text="收藏夹" /></StackPanel>
                        </Button>
                        <Button x:Name="RulesNavButton" Style="{StaticResource NavButton}" Click="ShowRules_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Width="24" FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE8FD;" /><TextBlock Text="规则与收纳" /></StackPanel>
                        </Button>
                        <Button x:Name="HistoryNavButton" Style="{StaticResource NavButton}" Click="ShowHistory_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Width="24" FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE81C;" /><TextBlock Text="历史" /></StackPanel>
                        </Button>
                        <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="ShowSettings_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Width="24" FontFamily="Segoe Fluent Icons" FontSize="16" Text="&#xE713;" /><TextBlock Text="设置" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Grid.Row="3" Padding="12,15,12,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                        <StackPanel><TextBlock Foreground="{StaticResource SageBrush}" FontSize="12" FontWeight="SemiBold" Text="桌面已保持整洁" />
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Text="目标重名时自动安全重命名，不覆盖已有文件。" /></StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid x:Name="InboxView" Grid.Column="1" Margin="44,34,44,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="桌面收件箱" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="规则决定去向，收纳窗口呈现内容。" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Click="PrepareDemo_Click" Content="准备演示文件" />
                        <Button Margin="0,0,8,0" Click="RealDesktop_Click" Content="真实桌面" />
                        <Button Click="Scan_Click" Content="扫描桌面" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="0,24,0,0" Padding="0,14" BorderBrush="{StaticResource InkBrush}" BorderThickness="0,1,0,1" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="3" Height="32" Margin="0,0,14,0" Background="{StaticResource ChampagneBrush}" />
                        <StackPanel Grid.Column="1" Margin="18,0,0,0">
                            <TextBlock x:Name="SourcePathText" Foreground="{StaticResource InkBrush}" FontFamily="{StaticResource DataFont}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ManagedPathText" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource MetricCell}">
                        <StackPanel><TextBlock x:Name="InboxCount" FontSize="23" FontWeight="Bold" Text="0" /><TextBlock Foreground="#68716D" Text="可整理项目" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricCell}">
                        <StackPanel><TextBlock x:Name="PlanCount" FontSize="23" FontWeight="Bold" Text="0" /><TextBlock Foreground="#68716D" Text="本次整理计划" /></StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource MetricCell}">
                        <StackPanel><TextBlock x:Name="PlanSizeText" FontSize="23" FontWeight="Bold" Text="0 B" /><TextBlock Foreground="#68716D" Text="计划已知总大小" /></StackPanel>
                    </Border>
                    <Border Grid.Column="6" Style="{StaticResource MetricCell}" BorderThickness="0">
                        <StackPanel><TextBlock x:Name="RiskCount" FontSize="23" FontWeight="Bold" Foreground="#A76106" Text="0 / 0" /><TextBlock Foreground="#68716D" Text="冲突 / 本次排除" /></StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="16,13">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="整理预览" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="InboxFavoriteCombo" Width="125" Margin="0,0,8,0" Visibility="Collapsed"
                                          DisplayMemberPath="Name" SelectionChanged="InboxFavoriteCombo_SelectionChanged" />
                                <Button x:Name="AddToFavoriteButton" Margin="0,0,8,0" IsEnabled="False" Visibility="Collapsed"
                                        Click="AddToFavorite_Click" Content="加入收藏夹" />
                                <Button x:Name="ResolveConflictButton" Margin="0,0,8,0" IsEnabled="False"
                                        Click="ResolveConflict_Click" Content="处理选中冲突" />
                                <Button x:Name="CreatePlanButton" Click="CreatePlan_Click" Content="生成整理计划" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="16,0,16,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" /><ColumnDefinition Width="10" />
                                <ColumnDefinition Width="115" /><ColumnDefinition Width="10" />
                                <ColumnDefinition Width="130" /><ColumnDefinition Width="10" />
                                <ColumnDefinition Width="135" /><ColumnDefinition Width="10" />
                                <ColumnDefinition Width="140" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InboxSearchText" Height="34" Padding="9,6"
                                     AutomationProperties.Name="按项目名称搜索"
                                     TextChanged="InboxFilter_Changed" ToolTip="按项目名称搜索" />
                            <ComboBox x:Name="InboxKindFilter" Grid.Column="2" Height="34"
                                      SelectionChanged="InboxFilter_Changed">
                                <ComboBoxItem Content="全部类型" Tag="Any" IsSelected="True" />
                                <ComboBoxItem Content="文件" Tag="File" />
                                <ComboBoxItem Content="文件夹" Tag="Folder" />
                                <ComboBoxItem Content="快捷方式" Tag="Shortcut" />
                            </ComboBox>
                            <ComboBox x:Name="InboxModifiedFilter" Grid.Column="4" Height="34"
                                      SelectionChanged="InboxFilter_Changed">
                                <ComboBoxItem Content="全部时间" Tag="Any" IsSelected="True" />
                                <ComboBoxItem Content="最近 7 天" Tag="Last7Days" />
                                <ComboBoxItem Content="最近 30 天" Tag="Last30Days" />
                                <ComboBoxItem Content="早于 30 天" Tag="OlderThan30Days" />
                            </ComboBox>
                            <ComboBox x:Name="InboxCreatedFilter" Grid.Column="6" Height="34"
                                      SelectionChanged="InboxFilter_Changed">
                                <ComboBoxItem Content="全部新增时间" Tag="Any" IsSelected="True" />
                                <ComboBoxItem Content="最近新增 7 天" Tag="AddedLast7Days" />
                                <ComboBoxItem Content="最近新增 30 天" Tag="AddedLast30Days" />
                                <ComboBoxItem Content="长期未处理" Tag="OlderThan30Days" />
                            </ComboBox>
                            <ComboBox x:Name="InboxSizeFilter" Grid.Column="8" Height="34"
                                      SelectionChanged="InboxFilter_Changed">
                                <ComboBoxItem Content="全部大小" Tag="Any" IsSelected="True" />
                                <ComboBoxItem Content="小于 1 MB" Tag="Under1Megabyte" />
                                <ComboBoxItem Content="1–100 MB" Tag="From1To100Megabytes" />
                                <ComboBoxItem Content="至少 100 MB" Tag="AtLeast100Megabytes" />
                            </ComboBox>
                            <Button Grid.Column="9" Margin="10,0,0,0" Click="ResetInboxFilters_Click" Content="重置" />
                            <Button Grid.Column="10" Margin="8,0,0,0" Click="SelectAllVisible_Click" Content="全选" />
                        </Grid>
                        <Grid Grid.Row="2" Margin="16,0,16,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Foreground="#68716D"
                                       Text="计划编辑仅影响当前草稿；重新生成计划即可恢复。" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button x:Name="ExcludePlanItemsButton" Margin="0,0,8,0" IsEnabled="False"
                                        Click="ExcludePlanItems_Click" Content="从计划排除" />
                                <Button x:Name="KeepOnlyPlanItemsButton" Margin="0,0,8,0" IsEnabled="False"
                                        Click="KeepOnlyPlanItems_Click" Content="仅执行选中项" />
                                <Button x:Name="AdjustPlanTargetButton" IsEnabled="False"
                                        Click="AdjustPlanTarget_Click" Content="修改目标" />
                            </StackPanel>
                        </Grid>
                        <Expander Grid.Row="3" Margin="16,0,16,10" Header="计划统计与风险" IsExpanded="False">
                            <Border Margin="0,8,0,0" Padding="12" CornerRadius="8" Background="#F4F6F4">
                                <StackPanel>
                                    <TextBlock x:Name="PlanSummaryText" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Text="尚未生成整理计划。" />
                                    <TextBlock x:Name="TargetDistributionText" Margin="0,7,0,0"
                                               Foreground="#365448" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PlanRiskDetailsText" Margin="0,7,0,0"
                                               Foreground="#A76106" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Expander>
                        <ListView Grid.Row="4" x:Name="PlanList" BorderThickness="0" Background="Transparent"
                                  AutomationProperties.Name="桌面项目和整理计划"
                                  SelectionMode="Extended"
                                  SelectionChanged="PlanList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="项目" Width="160" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="类型" Width="80" DisplayMemberBinding="{Binding Kind}" />
                                    <GridViewColumn Header="大小" Width="85" DisplayMemberBinding="{Binding SizeText}" />
                                    <GridViewColumn Header="修改时间" Width="125" DisplayMemberBinding="{Binding ModifiedText}" />
                                    <GridViewColumn Header="建议动作" Width="90" DisplayMemberBinding="{Binding Action}" />
                                    <GridViewColumn Header="目标位置" Width="210" DisplayMemberBinding="{Binding Target}" />
                                    <GridViewColumn Header="原因" Width="100" DisplayMemberBinding="{Binding Explanation}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <Grid Grid.Row="4" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#68716D" Text="请先准备演示文件并扫描。" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="KeepItemButton" Margin="0,0,8,0" IsEnabled="False"
                                Click="KeepItem_Click" Content="保留选中项" />
                        <Button x:Name="IgnoreItemButton" Margin="0,0,8,0" IsEnabled="False"
                                Click="IgnoreItem_Click" Content="忽略选中项" />
                        <Button x:Name="UndoButton" Margin="0,0,8,0" Click="Undo_Click" IsEnabled="False" Content="撤销上次整理" />
                        <Button x:Name="ExecuteButton" Style="{StaticResource PrimaryButton}" Click="Execute_Click" IsEnabled="False" Content="立即执行" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="FavoritesView" Grid.Column="1" Margin="44,34,44,32" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="收藏夹" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="用标签建立视图，不复制或移动原始文件。" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,20,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="收藏夹列表" />
                            <StackPanel Grid.Row="1" Margin="0,12,0,12">
                                <TextBox x:Name="FavoriteNameText" Height="36" Padding="9,7" MaxLength="40"
                                         AutomationProperties.Name="收藏夹名称" />
                                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                    <Button Click="CreateFavorite_Click" Content="新建" />
                                    <Button x:Name="RenameFavoriteButton" Margin="8,0,0,0" IsEnabled="False"
                                            Click="RenameFavorite_Click" Content="重命名" />
                                    <Button x:Name="DeleteFavoriteButton" Margin="8,0,0,0" IsEnabled="False"
                                            Click="DeleteFavorite_Click" Content="删除" />
                                </StackPanel>
                            </StackPanel>
                            <ListView x:Name="FavoritesList" Grid.Row="2" SelectionChanged="FavoritesList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="名称" Width="165" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="成员" Width="65" DisplayMemberBinding="{Binding Count}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Margin="16,14" FontSize="17" FontWeight="SemiBold" Text="成员" />
                            <ListView x:Name="FavoriteMembersList" Grid.Row="1" BorderThickness="0"
                                      SelectionChanged="FavoriteMembersList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="状态" Width="80" DisplayMemberBinding="{Binding Status}" />
                                        <GridViewColumn Header="项目" Width="180" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="路径" Width="390" DisplayMemberBinding="{Binding Path}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <StackPanel Grid.Row="2" Margin="16,12" Orientation="Horizontal">
                                <Button x:Name="LocateFavoriteMemberButton" IsEnabled="False"
                                        Click="LocateFavoriteMember_Click" Content="在资源管理器中定位" />
                                <Button x:Name="RebindFavoriteMemberButton" Margin="8,0,0,0" IsEnabled="False"
                                        Click="RebindFavoriteMember_Click" Content="重新绑定" />
                                <Button x:Name="RemoveFavoriteMemberButton" Margin="8,0,0,0" IsEnabled="False"
                                        Click="RemoveFavoriteMember_Click" Content="移除选中成员" />
                                <Button x:Name="RemoveMissingFavoriteMembersButton" Margin="8,0,0,0" IsEnabled="False"
                                        Click="RemoveMissingFavoriteMembers_Click" Content="清理全部失效成员" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <TextBlock x:Name="FavoritesStatusText" Grid.Row="2" Foreground="#68716D"
                           Text="新建收藏夹后，可从收件箱把选中项目加入其中。" />
            </Grid>

            <Grid x:Name="RulesView" Grid.Column="1" Margin="44,34,44,32" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="规则与收纳" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="每条规则对应一个桌面收纳窗口，文件匹配后直接归入。" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Margin="0,0,8,0" Click="ShowCollectionWindows_Click" Content="管理桌面窗口" />
                        <Button Click="RestoreDefaultRules_Click" Content="恢复默认规则" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Margin="0,20,0,14" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <ListView x:Name="RulesList" BorderThickness="0" Background="Transparent"
                              AutomationProperties.Name="整理规则列表" SelectionChanged="RulesList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="状态" Width="75" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="名称" Width="145" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="条件（全部满足）" Width="380" DisplayMemberBinding="{Binding Conditions}" />
                                <GridViewColumn Header="归档子目录" Width="180" DisplayMemberBinding="{Binding Destination}" />
                                <GridViewColumn Header="优先级" Width="75" DisplayMemberBinding="{Binding Priority}" />
                                <GridViewColumn Header="操作" Width="95">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Margin="8,5" Style="{StaticResource TableMenuButton}" Click="RuleActionsMenu_Click"
                                                    AutomationProperties.Name="打开规则操作菜单">
                                                <Button.Content>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="操作" />
                                                        <Path Width="8" Height="5" Margin="7,1,0,0" Stretch="Fill" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,1 L4,4 L7,1" />
                                                    </StackPanel>
                                                </Button.Content>
                                                <Button.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="编辑" Click="EditRuleRow_Click" />
                                                        <MenuItem Header="复制" Click="CopyRuleRow_Click" />
                                                        <MenuItem Header="启用 / 停用" Click="ToggleRuleRow_Click" />
                                                        <Separator />
                                                        <MenuItem Header="删除" Foreground="{StaticResource DangerBrush}" Click="DeleteRuleRow_Click" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="RuleEditorTitle" Margin="0,0,0,12" Style="{StaticResource SectionTitle}" Text="新增规则" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="12" /><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="#68716D" Text="规则名称" />
                                <TextBox x:Name="RuleNameText" Margin="0,5,0,0" Height="36" Padding="8,6"
                                         AutomationProperties.Name="规则名称" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="#68716D" Text="归档子目录" />
                                <TextBox x:Name="RuleDestinationText" Margin="0,5,0,0" Height="36" Padding="8,6"
                                         AutomationProperties.Name="规则归档子目录" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Foreground="#68716D" Text="优先级" />
                                <TextBox x:Name="RulePriorityText" Margin="0,5,0,0" Height="36" Padding="8,6" Text="100"
                                         AutomationProperties.Name="规则优先级" />
                            </StackPanel>
                            <StackPanel Grid.Column="5" Margin="12,21,0,0" Orientation="Horizontal">
                                <Button x:Name="SaveRuleButton" Style="{StaticResource PrimaryButton}" Click="AddRule_Click" Content="新增" />
                                <Button x:Name="CancelRuleEditButton" Margin="8,0,0,0" Visibility="Collapsed"
                                        Click="CancelRuleEdit_Click" Content="取消编辑" />
                                <Button x:Name="EditRuleButton" Visibility="Collapsed" IsEnabled="False" Click="EditRule_Click" Content="编辑" />
                                <Button x:Name="CopyRuleButton" Visibility="Collapsed" IsEnabled="False" Click="CopyRule_Click" Content="复制" />
                                <Button x:Name="ToggleRuleButton" Visibility="Collapsed" IsEnabled="False" Click="ToggleRule_Click" Content="停用" />
                                <Button x:Name="DeleteRuleButton" Visibility="Collapsed" IsEnabled="False" Click="DeleteRule_Click" Content="删除" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="规则条件（可选）" />
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" Text="条件全部留空时，该规则会匹配所有项目；可用优先级决定与其他规则的先后关系。" />
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="10" /><ColumnDefinition Width="110" /><ColumnDefinition Width="10" />
                                <ColumnDefinition Width="85" /><ColumnDefinition Width="10" /><ColumnDefinition Width="85" />
                                <ColumnDefinition Width="10" /><ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="#68716D" Text="扩展名" />
                                <TextBox x:Name="RuleExtensionsText" Margin="0,4,0,0" Padding="7,5" ToolTip="例如 .pdf,.docx；可留空"
                                         AutomationProperties.Name="规则扩展名条件" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="#68716D" Text="文件名关键词" />
                                <TextBox x:Name="RuleKeywordsText" Margin="0,4,0,0" Padding="7,5" ToolTip="逗号分隔；可留空"
                                         AutomationProperties.Name="规则文件名关键词" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Foreground="#68716D" Text="项目类型" />
                                <ComboBox x:Name="RuleItemKindCombo" Margin="0,4,0,0" Padding="6,4" SelectedIndex="0">
                                    <ComboBoxItem Content="不限" /><ComboBoxItem Content="文件" />
                                    <ComboBoxItem Content="文件夹" /><ComboBoxItem Content="快捷方式" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Foreground="#68716D" Text="最小 MB" />
                                <TextBox x:Name="RuleMinimumSizeText" Margin="0,4,0,0" Padding="7,5"
                                         AutomationProperties.Name="规则最小大小 MB" />
                            </StackPanel>
                            <StackPanel Grid.Column="8">
                                <TextBlock Foreground="#68716D" Text="最大 MB" />
                                <TextBox x:Name="RuleMaximumSizeText" Margin="0,4,0,0" Padding="7,5"
                                         AutomationProperties.Name="规则最大大小 MB" />
                            </StackPanel>
                            <StackPanel Grid.Column="10">
                                <TextBlock Foreground="#68716D" Text="最近 N 天" />
                                <TextBox x:Name="RuleModifiedWithinDaysText" Margin="0,4,0,0" Padding="7,5"
                                         AutomationProperties.Name="规则最近修改天数" />
                            </StackPanel>
                        </Grid>
                        <Border Margin="0,12,0,0" Padding="10" CornerRadius="7" Background="#F4F6F4">
                            <TextBlock x:Name="RuleImpactText" Foreground="#365448" TextWrapping="Wrap"
                                       Text="选择一条规则可预览它对当前扫描快照的影响。" />
                        </Border>
                        <TextBlock x:Name="RulesStatusText" Margin="0,10,0,0" Foreground="#68716D" Text="规则变更会立即作废当前整理计划。" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="HistoryView" Grid.Column="1" Margin="44,34,44,32" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="整理历史" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="查看操作记录，并在需要时恢复文件。" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="RefreshHistory_Click" Content="刷新历史" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,20,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <StackPanel><TextBlock x:Name="HistoryCount" FontSize="23" FontWeight="Bold" Text="0" /><TextBlock Foreground="#68716D" Text="最近操作" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel><TextBlock x:Name="RecoverableCount" FontSize="23" FontWeight="Bold" Foreground="{StaticResource SageBrush}" Text="0" /><TextBlock Foreground="{StaticResource GraphiteBrush}" Text="可撤销操作" /></StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.15*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="0.85*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <ListView x:Name="HistoryList" BorderThickness="0" Background="Transparent"
                                  AutomationProperties.Name="整理和撤销历史" SelectionChanged="HistoryList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="范围" Width="90" DisplayMemberBinding="{Binding ScopeText}" />
                                    <GridViewColumn Header="时间" Width="170" DisplayMemberBinding="{Binding StartedAt}" />
                                    <GridViewColumn Header="状态" Width="120" DisplayMemberBinding="{Binding Status}" />
                                    <GridViewColumn Header="项目" Width="200" DisplayMemberBinding="{Binding ItemSummary}" />
                                    <GridViewColumn Header="操作编号" Width="210" DisplayMemberBinding="{Binding OperationIdText}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TextBlock Margin="14,10,14,8" FontWeight="SemiBold" Text="操作项详情" />
                            <ListView x:Name="HistoryItemList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                                      SelectionChanged="HistoryItemList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="源路径" Width="270" DisplayMemberBinding="{Binding Source}" />
                                        <GridViewColumn Header="目标路径" Width="270" DisplayMemberBinding="{Binding Target}" />
                                        <GridViewColumn Header="状态" Width="90" DisplayMemberBinding="{Binding Status}" />
                                        <GridViewColumn Header="原因" Width="250" DisplayMemberBinding="{Binding Error}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="HistoryStatusText" VerticalAlignment="Center" Foreground="#68716D" Text="选择一条记录查看可用操作。" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="UndoSelectedItemButton" Margin="0,0,8,0" IsEnabled="False"
                                Click="UndoSelectedItem_Click" Content="撤销选中项" />
                        <Button x:Name="UndoSelectedButton" Style="{StaticResource PrimaryButton}"
                                Click="UndoSelected_Click" IsEnabled="False" Content="撤销剩余项目" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="CollectionWindowsView" Grid.Column="1" Margin="44,34,44,32" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="规则与收纳 · 窗口" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Text="每个规则映射一个桌面窗口，并保留文件的 Windows 原始图标。" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="ShowRules_Click" Content="返回整理规则" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,18,0,14" Orientation="Horizontal">
                    <Button Click="ShowAllCollectionWindows_Click" Content="显示全部" />
                    <Button Margin="8,0,0,0" Click="HideAllCollectionWindows_Click" Content="隐藏全部" />
                    <Button Margin="8,0,0,0" Click="ResetCollectionWindowsLayout_Click" Content="自动排列" />
                    <Button Margin="8,0,0,0" Click="RefreshCollectionWindows_Click" Content="刷新文件" />
                    <Button x:Name="ToggleShortcutWindowButton" Margin="24,0,0,0" Click="ToggleShortcutWindow_Click" Content="启用快速应用" />
                    <Button x:Name="ToggleCalendarWindowButton" Margin="8,0,0,0" Click="ToggleCalendarWindow_Click" Content="启用日历窗口" />
                    <Button x:Name="ToggleTodoWindowButton" Margin="8,0,0,0" Click="ToggleTodoWindow_Click" Content="启用待办事项" />
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ListView x:Name="CollectionWindowsList" BorderThickness="0" Background="Transparent"
                                  AutomationProperties.Name="桌面收纳窗口列表"
                                  SelectionChanged="CollectionWindowsList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="状态" Width="85" DisplayMemberBinding="{Binding Status}" />
                                    <GridViewColumn Header="窗口名称" Width="170" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="收纳子目录" Width="320" DisplayMemberBinding="{Binding RelativeDirectory}" />
                                    <GridViewColumn Header="关联规则" Width="90" DisplayMemberBinding="{Binding RuleCountText}" />
                                    <GridViewColumn Header="规则状态" Width="110" DisplayMemberBinding="{Binding RuleStatus}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Border Grid.Row="1" Padding="14" Background="#F4F6F4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="0" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Foreground="#68716D" Text="窗口名称" />
                                    <TextBox x:Name="CollectionWindowTitleText" Margin="0,5,0,0" Height="34" Padding="8,5"
                                             AutomationProperties.Name="收纳窗口名称" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Visibility="Collapsed">
                                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="窗口风格" />
                                    <ComboBox x:Name="CollectionWindowColorCombo" Margin="0,5,0,0" Height="34" SelectedIndex="0" IsHitTestVisible="False">
                                        <ComboBoxItem Content="静奢香槟" Tag="#AA8959" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="14,21,0,0" Orientation="Horizontal">
                                    <Button x:Name="ApplyCollectionWindowAppearanceButton" IsEnabled="False"
                                            Click="ApplyCollectionWindowAppearance_Click" Content="保存名称" />
                                    <Button x:Name="ToggleCollectionWindowButton" Margin="8,0,0,0" IsEnabled="False"
                                            Click="ToggleCollectionWindow_Click" Content="显示窗口" />
                                    <Button x:Name="OpenCollectionWindowButton" Margin="8,0,0,0" IsEnabled="False"
                                            Click="OpenCollectionWindow_Click" Content="打开窗口" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="CollectionWindowsStatusText" Foreground="{StaticResource MutedBrush}" Text="收纳窗口配置会随设置自动保存。" />
                    <TextBlock x:Name="DesktopWidgetsStatusText" Grid.Column="1" Foreground="{StaticResource MutedBrush}" Text="快速应用已关闭 · 日历窗口已关闭 · 待办事项已关闭" />
                </Grid>
            </Grid>

            <Grid x:Name="SettingsView" Grid.Column="1" Margin="44,34,44,32" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="设置" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Text="配置目录、快捷键、通知与本地数据。" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,8,0">
                <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="监控位置" />
                        <TextBlock Margin="0,5,0,10" Foreground="#68716D" TextWrapping="Wrap"
                                   Text="默认使用当前用户桌面；也可选择另一个现存目录作为唯一可执行源根。" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="MonitoredDirectoryText" Height="38" Padding="10,8" IsReadOnly="True"
                                     AutomationProperties.Name="当前监控目录" />
                            <Button Grid.Column="1" Margin="10,0,0,0" Click="ChooseMonitoredDirectory_Click" Content="选择目录" />
                        </Grid>
                        <CheckBox x:Name="IncludePublicDesktopCheck" Margin="0,10,0,16"
                                  Content="同时只读显示 Windows 公共桌面（不进入整理计划）" />
                        <Separator Margin="0,0,0,14" />
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="托管目录" />
                        <TextBlock Margin="0,5,0,12" Foreground="#68716D" TextWrapping="Wrap"
                                   Text="请选择桌面之外的专用目录。桌面与托管目录相同或互相包含时，底层整理模块会拒绝执行。" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="ManagedDirectoryText" Height="38" Padding="10,8" IsReadOnly="True" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="当前托管目录" />
                            <Button Grid.Column="1" Margin="10,0,0,0" Click="ChooseManagedDirectory_Click" Content="选择目录" />
                        </Grid>
                        <TextBlock x:Name="SettingsValidationText" Margin="0,12,0,0" Foreground="#68716D" Text="尚未选择托管目录。" />
                        <StackPanel Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SaveSettingsButton" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click"
                                    IsEnabled="False" Content="保存目录设置" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="窗口设置" />
                        <TextBlock Margin="0,5,0,14" Foreground="{StaticResource GraphiteBrush}" TextWrapping="Wrap"
                                   Text="所有收纳窗口使用透明表面，可选择纯色或渐变色；文件图标和文字保持完整不透明。" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource GraphiteBrush}" Text="全局表面透明度" />
                                    <TextBlock x:Name="CollectionWindowOpacityText" Grid.Column="1" Foreground="{StaticResource ChampagneDeepBrush}" FontFamily="{StaticResource DataFont}" Text="86%" />
                                </Grid>
                                <Slider x:Name="CollectionWindowOpacitySlider" Margin="0,10,0,0" Minimum="0.28" Maximum="0.96" Value="0.78"
                                        TickFrequency="0.01" IsSnapToTickEnabled="True" AutomationProperties.Name="收纳窗口表面透明度"
                                        ValueChanged="CollectionWindowOpacitySlider_ValueChanged" />
                                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" Text="纯色与渐变色共用此数值。" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Grid><TextBlock Foreground="{StaticResource GraphiteBrush}" Text="颜色填充" />
                                    <Button HorizontalAlignment="Right" Padding="10,4" Click="ReadDesktopColorsForAll_Click" AutomationProperties.Name="读取桌面颜色并应用到预览" Content="从桌面取色" />
                                </Grid>
                                <ComboBox x:Name="CollectionWindowFillModeCombo" Margin="0,8,0,0" Height="36" SelectionChanged="CollectionWindowFillModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="纯色" Tag="Solid" IsSelected="True" />
                                    <ComboBoxItem Content="渐变色" Tag="Gradient" />
                                </ComboBox>
                                <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Button x:Name="CollectionWindowStartColorButton" Margin="0,0,4,0" Height="36" Click="ChooseCollectionWindowStartColor_Click" AutomationProperties.Name="选择窗口表面颜色">
                                        <StackPanel Orientation="Horizontal"><Border x:Name="CollectionWindowStartColorPreview" Width="18" Height="18" CornerRadius="5" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" /><TextBlock x:Name="CollectionWindowStartColorText" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource DataFont}" /></StackPanel>
                                    </Button>
                                    <Button x:Name="CollectionWindowEndColorButton" Grid.Column="1" Margin="4,0,0,0" Height="36" Click="ChooseCollectionWindowEndColor_Click" AutomationProperties.Name="选择窗口渐变结束颜色">
                                        <StackPanel Orientation="Horizontal"><Border x:Name="CollectionWindowEndColorPreview" Width="18" Height="18" CornerRadius="5" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" /><TextBlock x:Name="CollectionWindowEndColorText" Margin="8,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource DataFont}" /></StackPanel>
                                    </Button>
                                </Grid>
                                <Border x:Name="CollectionWindowSurfacePreview" Margin="0,8,0,0" Height="34" CornerRadius="8" Background="#DC232B28" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="CollectionWindowAlwaysOnTopCheck" Visibility="Collapsed" Content="收纳窗口始终置于其他窗口上方" />
                        <Grid Margin="0,16,0,0">
                            <TextBlock x:Name="CollectionWindowSettingsStatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="保存后清除单窗口颜色并统一应用。" />
                            <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Click="ApplyCollectionWindowSettings_Click" Content="应用到所有窗口" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="应用行为" />
                        <CheckBox x:Name="StartWithWindowsCheck" Margin="0,12,0,0"
                                  Content="登录 Windows 后在系统托盘后台启动" />
                        <TextBlock x:Name="StartupStatusText" Margin="0,8,0,0" Foreground="#68716D"
                                   TextWrapping="Wrap" Text="正在读取开机启动设置…" />
                        <Button x:Name="ApplyStartupButton" Margin="0,12,0,0" HorizontalAlignment="Left"
                                Click="ApplyStartup_Click" Content="应用开机启动设置" />
                        <Separator Margin="0,16,0,12" />
                        <TextBlock FontWeight="SemiBold" Text="唤醒收件箱快捷键" />
                        <TextBlock Margin="0,5,0,0" Foreground="#68716D" TextWrapping="Wrap"
                                   Text="选择至少两个修饰键；新组合键注册成功后才会保存。" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <ComboBox x:Name="HotKeyModifiersCombo" Width="190" Height="34" />
                            <TextBlock Margin="8,0" VerticalAlignment="Center" Text="+" />
                            <ComboBox x:Name="HotKeyKeyCombo" Width="100" Height="34" />
                            <Button Margin="10,0,0,0" Click="ApplyGlobalHotKey_Click" Content="应用快捷键" />
                        </StackPanel>
                        <TextBlock x:Name="GlobalHotKeyStatusText" Margin="0,8,0,0" Foreground="#68716D"
                                   TextWrapping="Wrap" Text="默认使用 Ctrl + Alt + Space。" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="通知与免打扰" />
                        <CheckBox x:Name="NotificationsEnabledCheck" Margin="0,12,0,0"
                                  Content="在应用隐藏到托盘时显示状态通知" />
                        <CheckBox x:Name="QuietHoursCheck" Margin="0,8,0,0" Content="启用免打扰时段" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="从" />
                            <TextBox x:Name="QuietHoursStartText" Width="68" Margin="8,0" Padding="8,5" Text="22:00"
                                     AutomationProperties.Name="免打扰开始时间" />
                            <TextBlock VerticalAlignment="Center" Text="到" />
                            <TextBox x:Name="QuietHoursEndText" Width="68" Margin="8,0" Padding="8,5" Text="08:00"
                                     AutomationProperties.Name="免打扰结束时间" />
                        </StackPanel>
                        <TextBlock x:Name="NotificationSettingsStatusText" Margin="0,8,0,0" Foreground="#68716D"
                                   TextWrapping="Wrap" Text="默认在 22:00–08:00 期间免打扰。" />
                        <Button Margin="0,12,0,0" HorizontalAlignment="Left"
                                Click="ApplyNotifications_Click" Content="保存通知设置" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock FontSize="17" FontWeight="SemiBold" Text="项目处置偏好" />
                            <TextBlock x:Name="ItemPreferenceCountText" Grid.Column="1" Foreground="#68716D" Text="共 0 项" />
                        </Grid>
                        <TextBlock Margin="0,5,0,10" Foreground="#68716D" TextWrapping="Wrap"
                                   Text="保留项继续显示但不参与规则建议；忽略项不进入扫描结果。路径重命名后视为新项目。" />
                        <ListView x:Name="ItemPreferencesList" Height="130"
                                  SelectionChanged="ItemPreferencesList_SelectionChanged">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="处置" Width="90" DisplayMemberBinding="{Binding Disposition}" />
                                    <GridViewColumn Header="项目路径" Width="680" DisplayMemberBinding="{Binding Path}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <Button x:Name="RestoreItemPreferenceButton" Margin="0,10,0,0" HorizontalAlignment="Left"
                                IsEnabled="False" Click="RestoreItemPreference_Click" Content="恢复到收件箱" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="数据备份与恢复" />
                        <TextBlock Margin="0,5,0,0" Foreground="#68716D" TextWrapping="Wrap"
                                   Text="备份规则、通知设置、全局快捷键、项目处置偏好与操作历史。恢复前会校验版本和路径；开机启动状态不会导入。" />
                        <TextBlock x:Name="BackupStatusText" Margin="0,8,0,0" Foreground="#68716D"
                                   TextWrapping="Wrap" Text="尚未导出或导入备份。" />
                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Button Click="ExportBackup_Click" Content="导出备份" />
                            <Button Margin="10,0,0,0" Click="ImportBackup_Click" Content="导入并预检" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="诊断中心" />
                        <TextBlock Margin="0,5,0,0" Foreground="#68716D" TextWrapping="Wrap"
                                   Text="导出最近的脱敏诊断事件和运行环境摘要，不包含文件内容、设置数据库或用户名。" />
                        <TextBlock x:Name="DiagnosticEnvironmentText" Margin="0,8,0,0" Foreground="#68716D" TextWrapping="Wrap" />
                        <TextBlock x:Name="DiagnosticStatusText" Margin="0,5,0,0" Foreground="#68716D"
                                   TextWrapping="Wrap" Text="正在读取诊断摘要…" />
                        <Button Margin="0,12,0,0" HorizontalAlignment="Left"
                                Click="ExportDiagnostics_Click" Content="导出诊断包" />
                    </StackPanel>
                </Border>

                </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
