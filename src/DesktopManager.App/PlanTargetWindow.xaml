<Window x:Class="DesktopManager.App.PlanTargetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改当前计划目标" Width="650" Height="320"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PorcelainBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="23" FontWeight="Bold" Foreground="#18201D" Text="修改归档子目录" />
        <TextBlock x:Name="ItemText" Grid.Row="1" Margin="0,8,0,16" Foreground="{StaticResource GraphiteBrush}"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Row="2">
            <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="相对于托管目录的子目录" />
            <TextBox x:Name="RelativeDestinationText" Height="36" Padding="9,6"
                     AutomationProperties.Name="相对于托管目录的归档子目录"
                     TextChanged="RelativeDestinationText_Changed" />
        </StackPanel>
        <TextBlock Grid.Row="3" Margin="0,12,0,0" Foreground="{StaticResource GraphiteBrush}" TextWrapping="Wrap"
                   Text="文件名保持不变；目标不能越过托管目录。此修改只作用于当前草稿，不会改写整理规则。" />
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Padding="14,8" Click="Cancel_Click" Content="取消" />
                <Button x:Name="ConfirmButton" Margin="8,0,0,0" Padding="14,8"
                        Click="Confirm_Click" Style="{StaticResource QuietPrimaryButton}"
                        Content="应用到当前计划" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
