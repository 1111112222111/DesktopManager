<Window x:Class="DesktopManager.App.ShortcutTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加快速应用" Width="600" Height="410" MinWidth="540" MinHeight="390"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PorcelainBrush}"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource InkBrush}">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontWeight="SemiBold" Text="打开地址" />
            <TextBox x:Name="TargetText" Margin="0,8,0,0"
                     AutomationProperties.Name="快速应用地址" TextChanged="Input_Changed" />
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <Button Click="BrowseFile_Click" Content="选择文件或程序" />
                <Button Margin="8,0,0,0" Click="BrowseFolder_Click" Content="选择文件夹" />
            </StackPanel>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="显示名称（可留空）" />
                    <TextBox x:Name="NameText" Margin="0,8,0,0" AutomationProperties.Name="快速应用名称" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock FontWeight="SemiBold" Text="分组" />
                    <ComboBox x:Name="GroupComboBox" Margin="0,8,0,0" IsEditable="True"
                              AutomationProperties.Name="快速应用分组" />
                </StackPanel>
            </Grid>

            <Border Margin="0,18,0,0" Padding="12,10" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9">
                <DockPanel LastChildFill="True">
                    <TextBlock x:Name="TargetTypeText" DockPanel.Dock="Right" Margin="16,0,0,0"
                               Foreground="{StaticResource ChampagneDeepBrush}" FontFamily="{StaticResource DataFont}"
                               FontSize="10" VerticalAlignment="Center" />
                    <TextBlock x:Name="ValidationText" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="请输入网址，或选择文件、文件夹和程序。" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11"
                       Text="Enter 确认 · Esc 取消" />
            <Button Grid.Column="1" MinWidth="88" IsCancel="True" Content="取消" />
            <Button x:Name="SaveButton" Grid.Column="2" MinWidth="104" Margin="8,0,0,0"
                    Style="{StaticResource QuietPrimaryButton}" IsDefault="True"
                    Click="Save_Click" Content="添加应用" />
        </Grid>
    </Grid>
</Window>
