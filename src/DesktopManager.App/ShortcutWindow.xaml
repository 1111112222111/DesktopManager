<local:AdaptiveDesktopWindow x:Class="DesktopManager.App.ShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopManager.App"
        Title="快速应用" Width="360" Height="300" MinWidth="300" MinHeight="190"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="Transparent" AllowsTransparency="True" AllowDrop="True"
        FontFamily="{StaticResource BodyFont}" Foreground="{StaticResource GlassTextBrush}"
        Drop="Window_Drop" DragOver="Window_DragOver" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="{StaticResource GlassTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource QuietFocusVisual}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource GlassControlHoverBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource GlassControlPressedBrush}"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border CornerRadius="12" Background="{StaticResource GlassDarkBrush}" BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
            <Border x:Name="TitleBar" Background="Transparent" BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="0,0,0,1" Cursor="SizeAll" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal"><TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="CountText" Margin="10,2,0,0" Foreground="{StaticResource GlassMutedBrush}" FontFamily="{StaticResource DataFont}" FontSize="9"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource GlassWidgetIconButton}" Content="&#xE710;" ToolTip="新增快捷目标" AutomationProperties.Name="新增快捷目标" Click="Add_Click"/>
                        <Button Style="{StaticResource GlassWidgetIconButton}" Content="&#xE711;" ToolTip="关闭快速应用" AutomationProperties.Name="关闭快速应用" Click="RemoveWindow_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="ContentPanel" Grid.Row="1" Margin="10,8" Background="Transparent"
                  MouseLeftButtonDown="ContentPanel_MouseLeftButtonDown">
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource GlassMutedBrush}" TextAlignment="Center" Text="拖入文件、文件夹或程序&#x0a;也可点击＋新增网址"/>
                <ListBox x:Name="TargetsList" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
                         MouseDoubleClick="OpenItem_Click" PreviewMouseRightButtonDown="TargetsList_PreviewMouseRightButtonDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle><GroupStyle>
                        <GroupStyle.HeaderTemplate><DataTemplate>
                            <Border Margin="8,10,8,4" Padding="0,0,0,7" BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="0,0,0,1">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{StaticResource GlassTextBrush}" FontSize="11" FontWeight="SemiBold" Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" Foreground="{StaticResource GlassMutedBrush}" FontFamily="{StaticResource DataFont}" FontSize="9" Text="{Binding ItemCount, StringFormat={}{0} 项}"/>
                                    <Button Grid.Column="2" Height="26" MinHeight="26" Margin="12,0,0,0" Padding="9,0"
                                            Style="{StaticResource GlassWidgetActionButton}" Tag="{Binding}"
                                            AutomationProperties.Name="打开本组快速应用" Click="OpenGroup_Click" Content="打开本组"/>
                                </Grid>
                            </Border>
                        </DataTemplate></GroupStyle.HeaderTemplate>
                    </GroupStyle></ListBox.GroupStyle>
                    <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Target}"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid Width="28" Height="28"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{StaticResource ChampagneBrush}" Text="{Binding Glyph}"/><Image Source="{Binding Icon}" Width="28" Height="28"/></Grid>
                        <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,2,0,0" Foreground="{StaticResource GlassMutedBrush}" FontSize="10" Text="{Binding KindText}"/></StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource GlassWidgetIconButton}" Content="&#xE8A7;" ToolTip="打开" AutomationProperties.Name="打开快捷目标" Tag="{Binding}" Click="OpenRow_Click"/>
                    </Grid></DataTemplate></ListBox.ItemTemplate>
                    <ListBox.ContextMenu><ContextMenu><MenuItem Header="打开" Click="OpenItem_Click"/><MenuItem Header="编辑" Click="Edit_Click"/><Separator/><MenuItem Header="删除快速应用" Click="Delete_Click"/></ContextMenu></ListBox.ContextMenu>
                </ListBox>
            </Grid>
            <Grid Grid.Row="2" Margin="12,6,12,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Style="{StaticResource GlassWidgetActionButton}" HorizontalAlignment="Left" Click="OpenSelected_Click" Content="打开选中"/>
                <Button Grid.Column="1" Style="{StaticResource GlassWidgetAccentButton}" Click="OpenAll_Click" Content="全部打开"/>
            </Grid>
        </Grid>
    </Border>
</local:AdaptiveDesktopWindow>
