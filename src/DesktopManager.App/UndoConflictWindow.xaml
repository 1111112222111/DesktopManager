<Window x:Class="DesktopManager.App.UndoConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="处理撤销位置冲突" Width="680" Height="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource PorcelainBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="23" FontWeight="Bold" Foreground="#18201D" Text="原位置已有同名项目" />
        <TextBlock x:Name="ConflictPathText" Grid.Row="1" Margin="0,8,0,16"
                   Foreground="{StaticResource GraphiteBrush}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2">
            <RadioButton x:Name="SafeRenameOption" Margin="0,0,0,12" IsChecked="True"
                         Checked="Option_Changed" Content="使用安全名称恢复（推荐，不覆盖现有项目）" />
            <RadioButton x:Name="SkipOption" Margin="0,0,0,12"
                         Checked="Option_Changed" Content="跳过这个项目，本次不恢复" />
            <RadioButton x:Name="AlternateOption" Checked="Option_Changed"
                         Content="恢复到桌面范围内的其他完整路径" />
            <TextBox x:Name="AlternatePathText" Margin="24,8,0,0" Height="36" Padding="9,6"
                     AutomationProperties.Name="新的完整恢复路径"
                     IsEnabled="False" TextChanged="AlternatePathText_Changed" />
            <TextBlock x:Name="AllowedRootText" Margin="24,7,0,0" Foreground="{StaticResource GraphiteBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource GraphiteBrush}"
                       Text="任何选项都不会覆盖已有文件或文件夹。" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Padding="14,8" Click="Cancel_Click" Content="取消" />
                <Button x:Name="ConfirmButton" Margin="8,0,0,0" Padding="14,8"
                        Click="Confirm_Click" Style="{StaticResource QuietPrimaryButton}"
                        Content="继续撤销" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
